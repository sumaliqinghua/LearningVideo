# Qiniu Cloud API Configuration
# 七牛云 API 配置

# API Key (required)
# 七牛云 API 密钥（必填）
QINIU_API_KEY=your_qiniu_api_key_here

# API Base URL (optional, defaults to https://api.qnaigc.com/v1)
# API 基础 URL（可选，默认为 https://api.qnaigc.com/v1）
QINIU_API_BASE_URL=https://api.qnaigc.com/v1

# Text Model (optional, defaults to deepseek-v3)
# 文本模型（可选，默认为 deepseek-v3）
QINIU_TEXT_MODEL=deepseek-v3

# Legacy fallback (will be used if QINIU_API_KEY is not set)
# 旧版兼容（如果没有设置 QINIU_API_KEY 将使用此密钥）
# API_KEY=your_legacy_api_key_here
